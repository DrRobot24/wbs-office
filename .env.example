#
# Copia questo file in .env e compila i valori.
# Senza queste variabili l'app funziona in modalità offline (localStorage).

# Supabase Project URL (es: https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anon/Public Key
VITE_SUPABASE_ANON_KEY=
